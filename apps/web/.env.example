# ─── Database ─────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/jl-dental?retryWrites=true&w=majority

# ─── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET=<min-32-char-random-secret-change-this>
JWT_EXPIRY=7d

# ─── Cloudinary ───────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ─── Email (Resend) ───────────────────────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=hello@jldental.com

# ─── Rate Limiting (Upstash Redis) ────────────────────────────────────────────
UPSTASH_REDIS_REST_URL=https://<db>.upstash.io
UPSTASH_REDIS_REST_TOKEN=<token>

# ─── Cron Security ────────────────────────────────────────────────────────────
CRON_SECRET=<min-16-char-random-secret>

# ─── WhatsApp notifications (optional — safe no-op until configured) ─────────
# Primary: Meta WhatsApp Cloud API (free tier ~1,000 conversations/month).
# Requires a Meta Business account, a WhatsApp Business number, and an
# APPROVED message template (default name: appointment_confirmed) with
# 3 body params: {{1}} patient name, {{2}} date, {{3}} time.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_CONFIRM_TEMPLATE=appointment_confirmed

# Fallback: Twilio WhatsApp (used only if Meta vars are unset)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# ─── Public (safe for browser) ────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name

# ─── Build / CI ───────────────────────────────────────────────────────────────
# SKIP_ENV_VALIDATION=true   ← CI only, never production
